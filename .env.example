# PitchReady environment template — placeholders only. Copy to .env (never commit .env).
# Demo mode needs NOTHING below except APP_MODE=demo.

# demo | connected. Demo binds to 127.0.0.1 and is refused with NODE_ENV=production.
APP_MODE=demo
APP_BASE_URL=http://localhost:3000
# HOST=127.0.0.1
# PORT=3000

# ---- Connected mode: Supabase (server reads these; the browser never talks to Supabase directly)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase "publishable" key (sb_publishable_...). Public by design, but only used server-side here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase "secret" key (sb_secret_...). SERVER ONLY. Legacy JWT service_role keys also work.
SUPABASE_SECRET_KEY=
# Owner connection string, only for one-time CLI scripts (bootstrap/seed). Not needed by the web server.
# DATABASE_URL=

# ---- AI providers (server only). Live calls stay OFF until every item in this block is set.
LIVE_AI_ENABLED=false
ANTHROPIC_API_KEY=
# Exact model IDs from https://docs.claude.com (models overview). No defaults are assumed.
ANTHROPIC_ROLEPLAY_MODEL=
ANTHROPIC_EVALUATION_MODEL=
DEEPGRAM_API_KEY=
# e.g. a Deepgram STT model listed at developers.deepgram.com (check availability for your account)
DEEPGRAM_STT_MODEL=
# e.g. a Deepgram Aura voice model ID
DEEPGRAM_TTS_MODEL=
# Spend guard (minor units of AI_BUDGET_CURRENCY, e.g. pence). Global = per calendar month across all agencies;
# agency = per usage period. These are local estimates; also set provider-side limits where available.
AI_GLOBAL_BUDGET_MINOR_UNITS=
AI_AGENCY_BUDGET_MINOR_UNITS=
AI_BUDGET_CURRENCY=
# JSON rate card with current unit prices you looked up (see config/rate-card.example.json).
PROVIDER_RATE_CARD_PATH=

# Tests/CI only: AI_PROVIDER=mock uses labelled rule-based mocks (refused in production).
# AI_PROVIDER=mock

# ---- Policy
TRANSCRIPT_RETENTION_DAYS=30
# Hypotheses, not commitments: 150 min pilot, 600 min subscription. Applied per agency at bootstrap.
PILOT_INCLUDED_SECONDS=9000
SUBSCRIPTION_INCLUDED_SECONDS=36000

# ---- Scheduler: shared secret for POST /api/maintenance (32+ random chars, e.g. `openssl rand -hex 32`)
MAINTENANCE_SECRET=
